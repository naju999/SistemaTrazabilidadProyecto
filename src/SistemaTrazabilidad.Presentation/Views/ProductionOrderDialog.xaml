<Window x:Class="SistemaTrazabilidad.Presentation.Views.ProductionOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SistemaTrazabilidad.Presentation.Views"
        Title="Nueva orden de producción"
        Width="960"
        Height="570"
        MinWidth="780"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F7FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Nueva orden de producción"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>
            <TextBlock Text="Agrega cada insumo con su lote y cantidad requerida."
                       Margin="0,5,0,0"
                       Foreground="#64748B"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom"
                    Margin="0,18,0,12">
            <TextBlock Text="Fecha de inicio"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#334155"
                       Margin="0,0,10,0"/>
            <DatePicker x:Name="FechaInicioPicker"
                        Width="170"
                        Height="36"/>
            <Button Content="Agregar insumo"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="14,0,0,0"
                    Click="AgregarInsumo_Click"/>
        </StackPanel>

        <DataGrid x:Name="LineasGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding Lineas}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionUnit="Cell"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  RowHeight="50"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  BorderBrush="#E2E8F0"
                  BorderThickness="1">
            <DataGrid.Resources>
                <Style x:Key="ProductionComboBoxItemStyle" TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#334155"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#E8EEF4"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E8EEF4"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#334155"/>
                    <Setter Property="BorderBrush" Value="#EDF2F8"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="BorderBrush" Value="#EDF2F8"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F8FAFC"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#334155"/>
                    <Setter Property="BorderBrush" Value="#EDF2F8"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="BorderBrush" Value="#EDF2F8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Insumo" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="3,2">
                                <ComboBox ItemsSource="{Binding DataContext.Insumos, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      SelectedItem="{Binding InsumoSeleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="40"
                                      Background="White"
                                      BorderBrush="#CBD5E1"
                                      BorderThickness="1"
                                      VerticalContentAlignment="Center"
                                      Padding="8,4"
                                      FontSize="13"
                                      ItemContainerStyle="{StaticResource ProductionComboBoxItemStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Nombre}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Codigo}"
                                                           Margin="8,0,0,0"
                                                           Foreground="#64748B"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Selecciona un insumo"
                                           Margin="10,0,30,0"
                                           VerticalAlignment="Center"
                                           Foreground="#94A3B8"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TieneInsumoSeleccionado}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Lote" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="3,2">
                                <ComboBox ItemsSource="{Binding LotesDisponibles}"
                                      SelectedItem="{Binding LoteSeleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding TieneInsumoSeleccionado}"
                                      Height="40"
                                      Background="White"
                                      BorderBrush="#CBD5E1"
                                      BorderThickness="1"
                                      VerticalContentAlignment="Center"
                                      Padding="8,4"
                                      FontSize="13"
                                      ItemContainerStyle="{StaticResource ProductionComboBoxItemStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CodigoInterno}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CantidadDisponible, StringFormat={}{0} disponibles}"
                                                           Margin="8,0,0,0"
                                                           Foreground="#64748B"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding LotePlaceholder}"
                                           Margin="10,0,30,0"
                                           VerticalAlignment="Center"
                                           Foreground="#94A3B8"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TieneLoteSeleccionado}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Cantidad requerida" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding CantidadTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Margin="3,2"
                                     Height="40"
                                     VerticalContentAlignment="Center"
                                     SelectionBrush="#CBD5E1"
                                     SelectionOpacity="0.7"
                                     views:NumericTextBoxBehavior.UseThousandsSeparator="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header=" " Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Quitar"
                                    Style="{StaticResource DangerButtonStyle}"
                                    MinHeight="30"
                                    Padding="8,4"
                                    Click="QuitarInsumo_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="MensajeErrorTextBlock"
                       Foreground="#B91C1C"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        MinWidth="100"
                        Margin="0,0,10,0"
                        Padding="12,7"
                        Click="Cancelar_Click"/>
                <Button Content="Guardar orden"
                        MinWidth="130"
                        Style="{StaticResource SuccessButtonStyle}"
                        Click="Guardar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
