<Window x:Class="SistemaTrazabilidad.Presentation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Sistema de Trazabilidad La Española"
        Width="440"
        Height="455"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FA">
    <Grid>
        <Border Width="360"
                Padding="28"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
        <StackPanel>
            <!-- Encabezado -->
            <TextBlock Text="SISTEMA DE TRAZABILIDAD" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="#1E293B" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,10"/>
            
            <TextBlock Text="La Española - Fábrica de Bocadillos" 
                       FontSize="12" 
                       Foreground="#64748B" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <!-- Usuario -->
            <TextBlock Text="Usuario" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
            <TextBox x:Name="UsernameTextBox" 
                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBoxStyle}"
                     Margin="0,0,0,14"/>

            <!-- Contraseña -->
            <TextBlock Text="Contraseña" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox"
                         Padding="10"
                         Height="36"
                         FontSize="13"
                         BorderThickness="1"
                         BorderBrush="#CBD5E1"
                         Background="White"
                         Margin="0,0,0,6"/>

            <!-- Mensaje de Error -->
            <TextBlock Text="{Binding MensajeError}" 
                       FontSize="11" 
                       Foreground="Red" 
                       TextWrapping="Wrap" 
                       Margin="0,5,0,0"/>

            <!-- Botón Login -->
            <Button Content="INGRESAR" 
                    Command="{Binding LoginCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="42"
                    FontSize="13"
                    Margin="0,14,0,0"/>

            <!-- Indicador de carga -->
            <TextBlock Text="Cargando..." 
                       FontSize="11" 
                       Foreground="#0066CC" 
                       HorizontalAlignment="Center"
                       Visibility="{Binding Cargando, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Credenciales de prueba -->
            <TextBlock FontSize="10" Foreground="#94A3B8" TextAlignment="Center" Margin="0,18,0,0">
                <Run Text="Prueba: admin / admin123"/>
            </TextBlock>
        </StackPanel>
        </Border>
    </Grid>
</Window>
