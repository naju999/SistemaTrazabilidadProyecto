<UserControl x:Class="SistemaTrazabilidad.Presentation.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F4F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,22">
            <Grid>
                <StackPanel>
                    <TextBlock Text="📋 AUDITORÍA" Style="{StaticResource ModuleHeaderTitleStyle}"/>
                    <TextBlock Text="Historial de movimientos para respaldar trazabilidad, cambios de inventario y controles." Style="{StaticResource ModuleSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Exportar PDF"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Exporta los registros visibles con sus filtros actuales a un documento PDF."
                            Click="ExportarReporte_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="24,20,24,0" Padding="16">
            <WrapPanel>
                <StackPanel Width="240" Margin="0,0,12,0">
                    <TextBlock Text="Buscar" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                    <TextBox x:Name="BusquedaAuditoria" Style="{StaticResource InputTextBoxStyle}" ToolTip="Entidad, ID de usuario o detalle"/>
                </StackPanel>
                <StackPanel Width="160" Margin="0,0,12,0">
                    <TextBlock Text="Desde" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DesdeAuditoriaPicker" Height="36"/>
                </StackPanel>
                <StackPanel Width="160" Margin="0,0,12,0">
                    <TextBlock Text="Hasta" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                    <DatePicker x:Name="HastaAuditoriaPicker" Height="36"/>
                </StackPanel>
                <StackPanel Width="190" Margin="0,0,12,0">
                    <TextBlock Text="Acción" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="AccionAuditoriaCombo" Style="{StaticResource FilterComboBoxStyle}" SelectedIndex="0">
                        <ComboBoxItem Content="Todas"/>
                        <ComboBoxItem Content="Creación"/>
                        <ComboBoxItem Content="Actualización"/>
                        <ComboBoxItem Content="Eliminación"/>
                        <ComboBoxItem Content="Bloqueo de lote"/>
                    </ComboBox>
                </StackPanel>
                <Button Content="🔍 Aplicar" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Click="BuscarAuditoria_Click"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="24,16,24,24">
            <Grid>
                <DataGrid Style="{StaticResource ModuleDataGridStyle}" ItemsSource="{Binding AuditEvents}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha y hora" Binding="{Binding FechaHora}" Width="170"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="180"/>
                        <DataGridTextColumn Header="Módulo" Binding="{Binding Modulo}" Width="140"/>
                        <DataGridTextColumn Header="Entidad" Binding="{Binding Entidad}" Width="150"/>
                        <DataGridTextColumn Header="Registro" Binding="{Binding Registro}" Width="100"/>
                        <DataGridTemplateColumn Header="Acción" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#E8F4FD" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding Accion}" Foreground="#086BC1" Style="{StaticResource BadgeTextStyle}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="Resumen" Binding="{Binding DetalleResumen}" Width="*"/>
                        <DataGridTemplateColumn Header="Acciones" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Detalle" Style="{StaticResource PrimaryButtonStyle}" MinHeight="28" Padding="10,4" FontSize="11" Margin="0,3" Click="VerDetalleAuditoria_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="No hay movimientos auditados para mostrar" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Aquí se listarán accesos, cambios, eliminaciones y eventos de trazabilidad." FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
