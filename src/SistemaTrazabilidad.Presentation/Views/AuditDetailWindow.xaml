<Window x:Class="SistemaTrazabilidad.Presentation.Views.AuditDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de auditoría"
        Width="860"
        Height="680"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FA"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#086BC1" Padding="24,18">
            <StackPanel>
                <TextBlock x:Name="HeaderTitle"
                           Text="Detalle de auditoría"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock x:Name="HeaderSubtitle"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="#E8F4FD"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Margin="20"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DetailText"
                           FontSize="13"
                           LineHeight="21"
                           Foreground="#334155"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Button Content="Cerrar"
                    Width="110"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsCancel="True"
                    Click="Cerrar_Click"/>
        </Border>
    </Grid>
</Window>
