<UserControl x:Class="SistemaTrazabilidad.Presentation.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="DashboardChartRowTemplate">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#475569"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Label}"/>
                <ProgressBar Grid.Column="1"
                             Height="12"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Percentage}"
                             Background="#E8EDF2"
                             Foreground="{Binding Color}"
                             BorderThickness="0"
                             VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Count}"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F4F7FA" Loaded="UserControl_Loaded">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <TextBlock Text="DASHBOARD"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           Margin="0,0,0,22"/>

                <Border Background="#E8F4FD"
                        CornerRadius="4"
                        Padding="15"
                        Margin="0,0,0,14"
                        Visibility="{Binding Cargando, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Actualizando indicadores..."
                               FontSize="12"
                               Foreground="#0066CC"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0"
                            Background="White"
                            CornerRadius="8"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="Estado del inventario"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>
                            <TextBlock Text="Insumos activos según su stock disponible"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,4,0,10"/>
                            <ItemsControl ItemsSource="{Binding StockChart}"
                                          ItemTemplate="{StaticResource DashboardChartRowTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1"
                            Background="White"
                            CornerRadius="8"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Padding="20"
                            Margin="8,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Alertas activas por tipo"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>
                            <TextBlock Text="Cantidad de alertas sin resolver"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,4,0,10"/>
                            <ItemsControl ItemsSource="{Binding AlertsChart}"
                                          ItemTemplate="{StaticResource DashboardChartRowTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0"
                            Background="White"
                            CornerRadius="8"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,8,8,0">
                        <StackPanel>
                            <TextBlock Text="Órdenes iniciadas · últimos 7 días"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>
                            <TextBlock Text="Órdenes por fecha de inicio"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,4,0,10"/>
                            <ItemsControl ItemsSource="{Binding ProductionChart}"
                                          ItemTemplate="{StaticResource DashboardChartRowTemplate}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1"
                            Background="White"
                            CornerRadius="8"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Padding="20"
                            Margin="8,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Vencimiento de lotes disponibles"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>
                            <TextBlock Text="Cantidad de lotes por tiempo hasta el vencimiento"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,4,0,10"/>
                            <ItemsControl ItemsSource="{Binding ExpiryChart}"
                                          ItemTemplate="{StaticResource DashboardChartRowTemplate}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
