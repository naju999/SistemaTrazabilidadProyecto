<Window x:Class="SistemaTrazabilidad.Presentation.Views.InventoryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SistemaTrazabilidad.Presentation.Views"
        Title="{Binding TituloVentana}"
        Width="540"
        Height="580"
        WindowStartupLocation="CenterOwner"
        Background="White"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Grid>
        <DockPanel>
            <!-- Encabezado -->
            <Border DockPanel.Dock="Top" Background="#086BC1" Padding="22,18">
                <TextBlock Text="{Binding TituloVentana}" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="White"/>
            </Border>

            <!-- Botones -->
            <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18" Height="72">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" 
                            Width="100" 
                            Height="36"
                            Background="#E2E8F0" 
                            Foreground="#333"
                            BorderThickness="0"
                            Margin="0,0,10,0"
                            Click="Cancelar_Click"/>
                    
                    <Button Content="Guardar" 
                            Width="100" 
                            Style="{StaticResource SuccessButtonStyle}"
                            Command="{Binding GuardarCommand}"/>
                </StackPanel>
            </Border>

            <!-- Contenido -->
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Nombre *" FontSize="12" Foreground="#333" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Nombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Unidad de medida *" FontSize="12" Foreground="#333" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox Height="36" Padding="10,5" BorderBrush="#CBD5E1" BorderThickness="1"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding UnidadMedida, Mode=TwoWay}">
                            <ComboBoxItem>kg</ComboBoxItem>
                            <ComboBoxItem>gramos</ComboBoxItem>
                            <ComboBoxItem>litros</ComboBoxItem>
                            <ComboBoxItem>ml</ComboBoxItem>
                            <ComboBoxItem>unidad</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Stock mínimo *" FontSize="12" Foreground="#333" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding StockMinimo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 views:NumericTextBoxBehavior.UseThousandsSeparator="True"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Estado *" FontSize="12" Foreground="#333" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox Height="36"
                                  Padding="8,4"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding Estado, Mode=TwoWay}">
                            <ComboBoxItem Content="Activo"/>
                            <ComboBoxItem Content="Inactivo"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Background="#FFE8D5" CornerRadius="4" Padding="10" Margin="0,0,0,10" Visibility="{Binding MensajeError, Converter={StaticResource StringToBoolVisibilityConverter}}">
                        <TextBlock Text="{Binding MensajeError}" FontSize="12" Foreground="#FF6B35" TextWrapping="Wrap"/>
                    </Border>

                    <Border Background="#E8F4FD" CornerRadius="4" Padding="10" Visibility="{Binding Cargando, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Guardando..." FontSize="12" Foreground="#0066CC"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
