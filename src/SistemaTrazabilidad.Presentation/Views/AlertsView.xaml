<UserControl x:Class="SistemaTrazabilidad.Presentation.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F4F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,22">
            <Grid>
                <StackPanel>
                    <TextBlock Text="🚨 ALERTAS" Style="{StaticResource ModuleHeaderTitleStyle}"/>
                    <TextBlock Text="Alertas automáticas de stock mínimo, lotes vencidos y próximos a vencer (7 días)." Style="{StaticResource ModuleSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Actualizar alertas" Style="{StaticResource PrimaryButtonStyle}" Click="ActualizarAlertas_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,20,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}" BorderBrush="#F7D1CC" Padding="16" Margin="0,0,6,0">
                    <StackPanel><TextBlock Text="Activas" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding ActiveCount}" Style="{StaticResource KpiValueStyle}" Foreground="#E45B48"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" BorderBrush="#FFE4A8" Padding="16" Margin="6,0">
                    <StackPanel><TextBlock Text="No leídas" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding UnreadCount}" Style="{StaticResource KpiValueStyle}" Foreground="#E99815"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" BorderBrush="#B6D7FF" Padding="16" Margin="6,0">
                    <StackPanel><TextBlock Text="Total" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding TotalCount}" Style="{StaticResource KpiValueStyle}" Foreground="#086BC1"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" BorderBrush="#CDEEDB" Padding="16" Margin="6,0,0,0">
                    <StackPanel><TextBlock Text="Resueltas" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding ResolvedCount}" Style="{StaticResource KpiValueStyle}" Foreground="#169B62"/></StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0" Padding="16">
                <WrapPanel>
                    <StackPanel Width="220" Margin="0,0,12,0">
                        <TextBlock Text="Tipo" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="TipoAlertaCombo" Style="{StaticResource FilterComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="Todos"/>
                            <ComboBoxItem Content="Stock mínimo"/>
                            <ComboBoxItem Content="Vencimiento"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,12,0">
                        <TextBlock Text="Estado" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="EstadoAlertaCombo" Style="{StaticResource FilterComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="Activas"/>
                            <ComboBoxItem Content="Todas"/>
                            <ComboBoxItem Content="Resueltas"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="🔍 Aplicar" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Click="FiltrarAlertas_Click"/>
                </WrapPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="24,16,24,24">
            <Grid>
                <DataGrid Style="{StaticResource ModuleDataGridStyle}" RowHeight="44" ItemsSource="{Binding Alerts}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="150"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="130"/>
                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="130"/>
                        <DataGridTextColumn Header="Mensaje" Binding="{Binding Mensaje}" Width="*"/>
                        <DataGridTemplateColumn Header="Estado" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFF3D4"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Entity.Activa}" Value="False">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Estado}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeTextStyle}">
                                                    <Setter Property="Foreground" Value="#A35F00"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Entity.Activa}" Value="False">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Acciones" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Resolver"
                                            IsEnabled="{Binding CanResolve}"
                                            Style="{StaticResource SuccessButtonStyle}"
                                            MinHeight="28"
                                            Padding="10,4"
                                            FontSize="11"
                                            Margin="0,3"
                                            Click="ResolverAlerta_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="No hay alertas con estos filtros" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Actualiza las alertas para comprobar las condiciones actuales del inventario." FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
