<Window x:Class="SistemaTrazabilidad.Presentation.Views.LotManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lotes del insumo"
        Width="1200"
        Height="620"
        MinWidth="980"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FA"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#086BC1" Padding="24,18">
            <StackPanel>
                <TextBlock Text="Lotes del insumo"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="{Binding ProductoDescripcion}"
                           Margin="0,5,0,0"
                           FontSize="13"
                           Foreground="#EAF4FF"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="18">
            <DockPanel>
                <TextBlock Text="{Binding MensajeEstado}"
                           Foreground="#64748B"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <Button DockPanel.Dock="Right"
                        Content="Cerrar"
                        Width="100"
                        Height="36"
                        Margin="16,0,0,0"
                        Background="#E2E8F0"
                        Foreground="#333"
                        BorderThickness="0"
                        Click="Cerrar_Click"/>
            </DockPanel>
        </Border>

        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="DISPONIBLE" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding DisponibleResumen}" FontSize="20" FontWeight="Bold" Foreground="#168354" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="RESERVADO" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ReservadoResumen}" FontSize="20" FontWeight="Bold" Foreground="#B7791F" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="LOTES" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding CantidadLotes}" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="3"
                        Content="＋ Registrar entrada"
                        IsEnabled="{Binding PuedeRegistrarEntrada}"
                        Click="RegistrarEntrada_Click"
                        VerticalAlignment="Center"
                        Padding="14,10"
                        Style="{StaticResource SuccessButtonStyle}"/>
            </Grid>

            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <DataGrid ItemsSource="{Binding Lotes}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              BorderThickness="0"
                              Background="White"
                              AlternatingRowBackground="#F9F9F9"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF2F7"
                              RowHeight="42"
                              ColumnHeaderHeight="42"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código de lote" Binding="{Binding CodigoInterno}" Width="220"/>
                            <DataGridTextColumn Header="Código anterior" Binding="{Binding CodigoLoteAnterior}" Width="150"/>
                            <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="170"/>
                            <DataGridTextColumn Header="Ingreso" Binding="{Binding FechaIngreso, StringFormat={}{0:dd/MM/yyyy}}" Width="105"/>
                            <DataGridTextColumn Header="Cantidad inicial" Binding="{Binding CantidadInicial, StringFormat={}{0:0.##}}" Width="110"/>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat={}{0:0.##}}" Width="90"/>
                            <DataGridTextColumn Header="Disponible" Binding="{Binding Disponible, StringFormat={}{0:0.##}}" Width="100"/>
                            <DataGridTextColumn Header="Reservado" Binding="{Binding Reservado, StringFormat={}{0:0.##}}" Width="95"/>
                            <DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimiento, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
