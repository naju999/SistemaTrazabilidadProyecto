<UserControl x:Class="SistemaTrazabilidad.Presentation.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F4F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,22">
            <Grid>
                <StackPanel>
                    <TextBlock Text="🛒 COMPRAS" Style="{StaticResource ModuleHeaderTitleStyle}"/>
                    <TextBlock Text="Órdenes de compra, recepción de insumos y control PEPS desde proveedores locales." Style="{StaticResource ModuleSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Borrador no disponible" Style="{StaticResource PrimaryButtonStyle}" Background="#8A6A3F" Margin="0,0,10,0" IsEnabled="False" ToolTip="El servicio actual no contempla guardar borradores."/>
                    <Button Content="➕ Nueva orden" Style="{StaticResource SuccessButtonStyle}" Click="NuevaCompra_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,20,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" BorderBrush="#D8C7A2" Margin="0,0,6,0">
                    <StackPanel><TextBlock Text="Pendientes de recepción" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding PendingCount}" Style="{StaticResource KpiValueStyle}" Foreground="#A35F00"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16" BorderBrush="#CDEEDB" Margin="6,0">
                    <StackPanel><TextBlock Text="Órdenes recibidas" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding ReceivedCount}" Style="{StaticResource KpiValueStyle}" Foreground="#169B62"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16" BorderBrush="#B6D7FF" Margin="6,0">
                    <StackPanel><TextBlock Text="Órdenes registradas" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding OrdersCount}" Style="{StaticResource KpiValueStyle}" Foreground="#086BC1"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="16" BorderBrush="#F7D1CC" Margin="6,0,0,0">
                    <StackPanel><TextBlock Text="Órdenes con lote" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding PurchasesWithLotsCount}" Style="{StaticResource KpiValueStyle}" Foreground="#E45B48"/></StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0" Padding="16">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Width="280" Margin="0,0,12,0">
                        <TextBlock Text="Buscar" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                        <TextBox x:Name="BusquedaCompra" Style="{StaticResource InputTextBoxStyle}" ToolTip="Orden, proveedor o insumo"/>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,12,0">
                        <TextBlock Text="Estado" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="EstadoCompraCombo" Style="{StaticResource FilterComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="Todos"/>
                            <ComboBoxItem Content="Pendiente"/>
                            <ComboBoxItem Content="Recibida"/>
                            <ComboBoxItem Content="Cancelada"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,12,0">
                        <TextBlock Text="Desde" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DesdeCompraPicker" Height="36"/>
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,12,0">
                        <TextBlock Text="Hasta" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                        <DatePicker x:Name="HastaCompraPicker" Height="36"/>
                    </StackPanel>
                    <Button Content="🔍 Aplicar" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Click="BuscarCompras_Click"/>
                </WrapPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="24,16,24,24">
            <Grid>
                <DataGrid Style="{StaticResource ModuleDataGridStyle}" ItemsSource="{Binding Purchases}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Orden" Binding="{Binding Orden}" Width="110"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="120"/>
                        <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*"/>
                        <DataGridTextColumn Header="Insumo" Binding="{Binding Insumo}" Width="180"/>
                        <DataGridTextColumn Header="Lote PEPS" Binding="{Binding LotePeps}" Width="130"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="100"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="120"/>
                        <DataGridTemplateColumn Header="Estado" Width="120">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#FFF3D4" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding Estado}" Foreground="#A35F00" Style="{StaticResource BadgeTextStyle}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Acciones" Width="180">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Recibir" Style="{StaticResource SuccessButtonStyle}" MinHeight="28" Padding="10,4" FontSize="11" Margin="0,3,6,3" Click="RecibirCompra_Click"/><Button Content="Cancelar" Style="{StaticResource DangerButtonStyle}" MinHeight="28" Padding="10,4" FontSize="11" Margin="0,3" Click="CancelarCompra_Click"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Sin órdenes cargadas para los filtros seleccionados" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Cuando se conecte la funcionalidad, aquí aparecerán compras, recepciones y lotes PEPS." FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
