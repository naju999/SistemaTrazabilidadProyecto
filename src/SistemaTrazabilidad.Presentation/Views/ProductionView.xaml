<UserControl x:Class="SistemaTrazabilidad.Presentation.Views.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F4F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,22">
            <Grid>
                <StackPanel>
                    <TextBlock Text="🏭 PRODUCCIÓN" Style="{StaticResource ModuleHeaderTitleStyle}"/>
                    <TextBlock Text="Planeación, consumo de insumos y seguimiento de lotes de bocadillo veleño." Style="{StaticResource ModuleSubtitleStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📦 Ver PEPS" Style="{StaticResource PrimaryButtonStyle}" Background="#8A6A3F" Margin="0,0,10,0" Click="VerPeps_Click"/>
                    <Button Content="➕ Nueva orden" Style="{StaticResource SuccessButtonStyle}" Click="NuevaOrdenProduccion_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,20,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}" BorderBrush="#B6D7FF" Padding="16" Margin="0,0,6,0">
                    <StackPanel><TextBlock Text="Programadas" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding ProgrammedCount}" Style="{StaticResource KpiValueStyle}" Foreground="#086BC1"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" BorderBrush="#FFE4A8" Padding="16" Margin="6,0">
                    <StackPanel><TextBlock Text="En proceso" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding InProcessCount}" Style="{StaticResource KpiValueStyle}" Foreground="#E99815"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" BorderBrush="#CDEEDB" Padding="16" Margin="6,0">
                    <StackPanel><TextBlock Text="Finalizadas" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding FinishedCount}" Style="{StaticResource KpiValueStyle}" Foreground="#169B62"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" BorderBrush="#F7D1CC" Padding="16" Margin="6,0,0,0">
                    <StackPanel><TextBlock Text="Insumos críticos" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding CriticalInputsCount}" Style="{StaticResource KpiValueStyle}" Foreground="#E45B48"/></StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0" Padding="16">
                <WrapPanel>
                    <StackPanel Width="260" Margin="0,0,12,0">
                        <TextBlock Text="Buscar orden" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                        <TextBox x:Name="BusquedaProduccion" Style="{StaticResource InputTextBoxStyle}" ToolTip="Orden, insumo o lote"/>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,12,0">
                        <TextBlock Text="Estado" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="EstadoProduccionCombo" Style="{StaticResource FilterComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="Todos"/>
                            <ComboBoxItem Content="Programada"/>
                            <ComboBoxItem Content="En proceso"/>
                            <ComboBoxItem Content="Finalizada"/>
                            <ComboBoxItem Content="Cancelada"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="🔍 Aplicar" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Click="BuscarProduccion_Click"/>
                </WrapPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="24,16,24,24">
            <Grid>
                <DataGrid Style="{StaticResource ModuleDataGridStyle}" ItemsSource="{Binding ProductionOrders}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Orden" Binding="{Binding Orden}" Width="120"/>
                        <DataGridTextColumn Header="Fecha inicio" Binding="{Binding FechaInicio}" Width="140"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/>
                        <DataGridTextColumn Header="Lote PEPS" Binding="{Binding LotePeps}" Width="160"/>
                        <DataGridTextColumn Header="Programado" Binding="{Binding Programado}" Width="120"/>
                        <DataGridTextColumn Header="Consumido" Binding="{Binding Consumido}" Width="120"/>
                        <DataGridTemplateColumn Header="Estado" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#E8F4FD" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding Estado}" Foreground="#086BC1" Style="{StaticResource BadgeTextStyle}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Acciones" Width="250"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Iniciar" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="28" Padding="10,4" FontSize="11" Margin="0,3,6,3" Click="IniciarProduccion_Click"/><Button Content="Finalizar" IsEnabled="{Binding CanFinish}" Style="{StaticResource SuccessButtonStyle}" MinHeight="28" Padding="10,4" FontSize="11" Margin="0,3,6,3" Click="FinalizarProduccion_Click"/><Button Content="Cancelar" IsEnabled="{Binding CanCancel}" Style="{StaticResource DangerButtonStyle}" MinHeight="28" Padding="10,4" FontSize="11" Margin="0,3" Click="CancelarProduccion_Click"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="No hay órdenes de producción registradas" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="La tabla queda lista para conectar programación, consumo y cierre de lotes." FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
