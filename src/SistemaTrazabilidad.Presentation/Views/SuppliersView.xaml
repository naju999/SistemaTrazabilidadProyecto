<UserControl x:Class="SistemaTrazabilidad.Presentation.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F4F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,22">
            <Grid>
                <StackPanel>
                    <TextBlock Text="🤝 PROVEEDORES" Style="{StaticResource ModuleHeaderTitleStyle}"/>
                    <TextBlock Text="Directorio, contactos y confiabilidad de abastecimiento para insumos de producción." Style="{StaticResource ModuleSubtitleStyle}"/>
                </StackPanel>
                <Button Content="➕ Nuevo proveedor" Style="{StaticResource SuccessButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="NuevoProveedor_Click"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,20,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}" Padding="16" BorderBrush="#CDEEDB" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="Proveedores activos" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding ActiveCount}" Style="{StaticResource KpiValueStyle}" Foreground="#169B62"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16" BorderBrush="#F7D1CC" Margin="8,0,0,0">
                <StackPanel><TextBlock Text="Proveedores inactivos" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding InactiveCount}" Style="{StaticResource KpiValueStyle}" Foreground="#E45B48"/></StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="24,16,24,24">
            <DataGrid Style="{StaticResource ModuleDataGridStyle}" ItemsSource="{Binding Suppliers}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110"/>
                    <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*"/>
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="140"/>
                    <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="220"/>
                    <DataGridTemplateColumn Header="Estado" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F7EF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Entity.Activo}" Value="False">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Estado}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeTextStyle}">
                                                <Setter Property="Foreground" Value="#169B62"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Entity.Activo}" Value="False">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Acciones" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Editar" Style="{StaticResource PrimaryButtonStyle}" MinHeight="28" Padding="10,4" FontSize="11" Margin="0,3" Click="EditarProveedor_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
