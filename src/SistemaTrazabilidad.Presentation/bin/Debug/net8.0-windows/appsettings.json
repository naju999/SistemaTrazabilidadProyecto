{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=traceability.db;Cache=Shared"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "Serilog": {
      "MinimumLevel": "Information",
      "WriteTo": [
        {
          "Name": "Console"
        },
        {
          "Name": "File",
          "Args": {
            "path": "logs/app-.txt",
            "rollingInterval": "Day",
            "retainedFileCountLimit": 30,
            "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
          }
        }
      ]
    }
  },
  "Application": {
    "Name": "Sistema de Trazabilidad - La Española",
    "Version": "1.0.0",
    "Environment": "Development"
  }
}
